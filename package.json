{
	"name": "@zokugun/eslint-typegen-plus",
	"description": "Convert ESLint rules into TypeScript definitions",
	"version": "0.1.0",
	"author": {
		"name": "Baptiste Augrain",
		"email": "daiyam@zokugun.org"
	},
	"license": "MIT",
	"homepage": "https://github.com/zokugun/node-eslint-typegen-plus",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zokugun/node-eslint-typegen-plus.git"
	},
	"bugs": {
		"url": "https://github.com/zokugun/node-eslint-typegen-plus/discussions/categories/issue-triage"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./lib/esm/index.mjs",
			"require": "./lib/cjs/index.cjs"
		}
	},
	"main": "lib/cjs/index.cjs",
	"module": "lib/esm/index.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./lib/cjs/index.d.cts"
			]
		}
	},
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run build:lib",
		"build:lib": "tsc-leda generate",
		"build:package": "tsc-leda update-package && npm run lint:package",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf lib; rimraf .src",
		"compile:src": "tsc -p src",
		"lint": "eslint",
		"lint:all": "npm run lint:package && npm audit && npm run ci:lint && npm run lint",
		"lint:fix": "eslint --fix",
		"lint:package": "fixpack || true",
		"prepack": "npm run build",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"update:artifacts": "artifact update",
		"update:ci": "pinact run -min-age 7 -update",
		"update:deps": "taze --all",
		"watch:build": "tsc-watch -p src --onSuccess 'npm run build'",
		"watch:src": "tsc-watch -p src"
	},
	"dependencies": {
		"@zokugun/fs-extra-plus": "0.6.1",
		"json-schema-to-typescript-lite": "15.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/json-schema": "7.0.15",
		"@types/node": "20.19.43",
		"@zokugun/tsc-leda": "0.5.1",
		"eslint": "10.8.1",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"release-it": "20.2.1",
		"rimraf": "6.1.3",
		"taze": "19.16.0",
		"tsc-watch": "7.2.1",
		"typescript": "5.9.3"
	},
	"overrides": {
		"release-it": {
			"undici": "7.29.0"
		}
	},
	"allowScripts": {
		"@zokugun/cli-utils": true
	},
	"keywords": [
		"dts",
		"eslint",
		"typegen",
		"typescript"
	]
}
